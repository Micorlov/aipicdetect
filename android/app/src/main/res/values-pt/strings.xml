    <string name="onboarding_pick_title">Escolhe uma foto</string>
    <string name="onboarding_pick_body">Escolhe uma imagem da tua galeria ou tira uma com a câmara. JPEG, PNG, WebP e HEIC funcionam, até 50 MB.</string>
    <string name="onboarding_score_title">Lê a pontuação</string>
    <string name="onboarding_score_body">Recebes uma probabilidade de IA e uma faixa de confiança \u2014 uma probabilidade, não um veredicto. Pontuações perto do meio são marcadas como Incerto.</string>
    <string name="onboarding_clean_title">Vê os metadados</string>
    <string name="onboarding_clean_body">O AiPicDetect lista todos os blocos EXIF, XMP, IPTC e C2PA do ficheiro e entrega-te uma cópia limpa sem nada disso.</string>
    <string name="onboarding_privacy_title">Nada é guardado</string>
    <string name="onboarding_privacy_body">A tua imagem é analisada em memória e nunca escrita em disco. Sem registo, sem rastreio, e tudo é código aberto.</string>
